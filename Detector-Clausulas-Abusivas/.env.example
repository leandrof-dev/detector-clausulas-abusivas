# Copie este arquivo para ".env" e preencha com as suas chaves.
# O arquivo ".env" nunca deve ser enviado ao GitHub. Cuidado!

# Supabase: painel do projeto > Project Settings > API Keys
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# API de IA (provedor a definir | Projeto Atual Usa GPT API)
IA_API_KEY=
MODELO_IA_REPETITIVO=
MODELO_IA_ANALISE=
# E-mail que recebe as mensagens da página Contato (se vazio, o formulário fica desativado)
CONTATO_EMAIL=

# Opcionais: o código já usa estes valores quando ficam vazios
# MODELO_EMBEDDING=text-embedding-3-large
# EMBEDDING_DIMENSOES=1536
